{
  "$schema": "https://developer.microsoft.com/json-schemas/tsdoc/v0/tsdoc.schema.json",
  "noStandardTags": false,
  "supportForTags": {
    "@alpha": true,
    "@beta": true,
    "@defaultValue": true,
    "@deprecated": true,
    "@example": true,
    "@inheritDoc": true,
    "@internal": true,
    "@link": true,
    "@packageDocumentation": true,
    "@param": true,
    "@public": true,
    "@remarks": true,
    "@returns": true,
    "@see": true,
    "@throws": true
  },
  "reportUnsupportedHtmlElements": true,
  "supportedHtmlElements": ["a", "b", "br", "code", "em", "i", "p", "pre", "strong"]
}
