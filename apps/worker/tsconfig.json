{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "paths": {
      "@draftroll/core": ["../../packages/core/src/index.ts"],
      "@draftroll/protocol": ["../../packages/protocol/src/index.ts"],
      "@draftroll/server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src", "worker-configuration.d.ts"]
}
