{
  "name": "draftroll-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:playground",
    "dev:playground": "vite --host 0.0.0.0",
    "dev:stack": "concurrently --kill-others --names worker,playground \"pnpm worker:dev\" \"pnpm dev:playground\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check:quality": "pnpm lint && pnpm fmt:check",
    "test:quality-config": "node scripts/test-code-quality-config.mjs",
    "check": "pnpm check:quality && pnpm test:quality-config && pnpm check:docs && pnpm check:packages && pnpm check:worker && tsc --noEmit",
    "check:packages": "tsc -p tsconfig.packages.json --noEmit",
    "check:worker": "pnpm --filter @draftroll/worker check",
    "build": "pnpm check && vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "worker:dev": "pnpm --filter @draftroll/worker dev",
    "worker:setup": "pnpm --filter @draftroll/worker db:migrate:local",
    "worker:reset": "pnpm --filter @draftroll/worker db:reset:local",
    "worker:smoke": "node scripts/smoke-worker.mjs",
    "worker:test:local": "node scripts/test-worker-local.mjs",
    "worker:deploy": "pnpm --filter @draftroll/worker deploy",
    "worker:history": "pnpm --filter @draftroll/worker db:history:local",
    "build:overlay": "pnpm check && vite build --config vite.overlay.config.ts",
    "preview:overlay": "vite preview --config vite.overlay.config.ts --outDir dist-overlay/draftroll --host 0.0.0.0",
    "dev:embed": "vite --host 0.0.0.0 --open /examples/embedded-host.html",
    "test:updates": "node scripts/test-roll-updates.mjs",
    "test:d20": "node scripts/test-d20-compat.mjs",
    "test:instrumentation": "node scripts/test-core-instrumentation.mjs",
    "test:diagnostics": "node scripts/test-validation-diagnostics.mjs",
    "test:modifier-sequences": "node scripts/test-modifier-sequencing.mjs",
    "test:core": "pnpm test:review-fixes && pnpm test:instrumentation && pnpm test:diagnostics && pnpm test:d20 && pnpm test:modifier-sequences && pnpm test:settlement-effects && pnpm test:common-dice && pnpm test:lifecycle && pnpm test:completion && pnpm test:resilience && pnpm test:worker-resilience && pnpm test:accessibility-controls && pnpm test:examples && pnpm test:updates && pnpm test:mixed-renderer && pnpm test:coin-physics && pnpm test:visual-fallbacks && pnpm test:generated-polyhedra && pnpm test:cards-demo && pnpm test:themes && pnpm test:client && pnpm test:room-protocol && pnpm test:validation && pnpm test:hardening && pnpm test:password && pnpm test:tokens && pnpm test:late-events && pnpm test:concurrent-table && pnpm test:natural-targets && pnpm test:large-pools && pnpm test:performance && pnpm test:browser:config && pnpm test:entrypoints",
    "test:mixed-renderer": "node scripts/test-mixed-renderer.mjs",
    "test:coin-physics": "node scripts/test-coin-physics.mjs",
    "test:client": "node scripts/test-character-client.mjs",
    "test:room-protocol": "node scripts/test-room-protocol.mjs",
    "test:visual-fallbacks": "node scripts/test-visual-fallbacks.mjs",
    "test:generated-polyhedra": "node scripts/test-generated-polyhedra.mjs",
    "test:cards-demo": "node scripts/test-cards-demo.mjs && node scripts/test-deck-atomicity.mjs",
    "test:themes": "node scripts/test-runtime-themes.mjs",
    "test:validation": "node scripts/test-runtime-validation.mjs && node scripts/test-protocol-boundary-safety.mjs",
    "test:hardening": "node scripts/test-room-hardening.mjs",
    "test:password": "node scripts/test-room-password.mjs",
    "test:tokens": "node scripts/test-token-security.mjs",
    "test:late-events": "node scripts/test-late-events.mjs",
    "test:browser:build": "vite build --config tests/browser/vite.config.ts",
    "test:browser:typecheck": "tsc -p tests/browser/tsconfig.json --noEmit",
    "test:browser": "pnpm test:browser:build && playwright test",
    "test:browser:chromium": "pnpm test:browser:build && playwright test --project=chromium",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "test:all": "pnpm test:core && pnpm worker:test:local && pnpm test:release && pnpm test:browser",
    "test:browser:config": "node scripts/test-browser-automation.mjs",
    "test:performance": "node scripts/test-renderer-performance.mjs",
    "test:browser:performance": "pnpm test:browser:build && playwright test tests/browser/specs/performance.spec.ts --project=chromium",
    "benchmark:renderer": "pnpm test:browser:build && playwright test tests/browser/specs/performance.spec.ts --project=chromium",
    "test:concurrent-table": "node scripts/test-concurrent-table-rolls.mjs",
    "test:natural-targets": "node scripts/test-natural-target-physics.mjs",
    "test:large-pools": "node scripts/test-large-pool-physics.mjs",
    "test:entrypoints": "node scripts/test-package-entrypoints.mjs",
    "test:common-dice": "node scripts/test-common-dice-helpers.mjs",
    "test:lifecycle": "node scripts/test-sdk-session-lifecycle.mjs",
    "worker:deploy:staging": "pnpm --filter @draftroll/worker deploy:staging",
    "worker:deploy:production": "pnpm --filter @draftroll/worker deploy:production",
    "worker:migrate:staging": "pnpm --filter @draftroll/worker db:migrate:staging",
    "worker:migrate:production": "pnpm --filter @draftroll/worker db:migrate:production",
    "worker:smoke:deployment": "node scripts/smoke-deployment.mjs",
    "worker:health": "node scripts/check-room-health.mjs",
    "test:completion": "node scripts/test-completion-api.mjs",
    "test:resilience": "node scripts/test-realtime-resilience.mjs",
    "test:worker-resilience": "node scripts/test-worker-resilience.mjs",
    "test:accessibility-controls": "node scripts/test-accessibility-controls.mjs",
    "benchmark:sdk": "node scripts/benchmark-sdk.mjs --output=benchmark-results/sdk.json",
    "test:examples": "node scripts/test-integration-examples.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "test:distribution": "node scripts/test-package-distribution.mjs",
    "test:review-fixes": "node scripts/test-sdk-review-fixes.mjs",
    "test:release": "pnpm check:quality && pnpm test:quality-config && pnpm check:docs && pnpm check:packages && pnpm test:entrypoints && pnpm test:tsdoc:declarations && pnpm test:distribution",
    "test:settlement-effects": "node scripts/test-settlement-effects.mjs",
    "check:docs": "node scripts/check-tsdoc.mjs",
    "check:docs:structure": "node scripts/check-tsdoc.mjs --structure-only",
    "test:tsdoc:declarations": "node scripts/build-packages.mjs && node scripts/test-tsdoc-declarations.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@microsoft/tsdoc": "^0.16.0",
    "@microsoft/tsdoc-config": "^0.18.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.178.1",
    "concurrently": "^9.2.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.17.0"
}
