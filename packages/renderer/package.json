{
  "name": "@draftroll/renderer",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./polyhedra": {
      "types": "./dist/polyhedra.d.ts",
      "default": "./dist/polyhedra.js"
    },
    "./physical": {
      "types": "./dist/physical.d.ts",
      "default": "./dist/physical.js"
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  },
  "dependencies": {
    "@draftroll/errors": "workspace:*",
    "@draftroll/protocol": "workspace:*",
    "@draftroll/themes": "workspace:*"
  }
}
